# Copy to config/deploy.local.env (git-ignored). The deploy scripts source it.
PROJECT=your-gcp-project-id
REGION=europe-west3
# The team id the hosted console serves (one of the teams in config/team.local.yaml).
TEAM=your-team
# Optional: where teammates clone this repository; shown in the console's join panel.
# JOIN_REPO_URL=https://github.com/you/team-relay
